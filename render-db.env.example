#
# Copie este arquivo para render-db.env e preencha com os dados do seu banco
# PostgreSQL no Render.
#
# Para rodar a aplicacao localmente usando o banco em nuvem, prefira a
# External Database URL do Render, com sslmode=require.
#

# Opcao 1: URL unica do banco no formato aceito pelo app
DATABASE_URL=postgresql://SEU_USUARIO:SUA_SENHA@SEU_HOST_RENDER:5432/SEU_BANCO?sslmode=require

# Opcao 2: variaveis Spring explicitas
# SPRING_DATASOURCE_URL=jdbc:postgresql://SEU_HOST_RENDER:5432/SEU_BANCO?sslmode=require
# SPRING_DATASOURCE_USERNAME=SEU_USUARIO
# SPRING_DATASOURCE_PASSWORD=SUA_SENHA

# Opcao 3: variaveis PG tradicionais
# PGHOST=SEU_HOST_RENDER
# PGPORT=5432
# PGDATABASE=SEU_BANCO
# PGUSER=SEU_USUARIO
# PGPASSWORD=SUA_SENHA

# Base URL local da aplicacao
APP_BASE_URL=http://localhost:8082
